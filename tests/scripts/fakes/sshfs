#!/usr/bin/env bash
# Fake sshfs: records the mount, as macOS or Linux would list it.
state="${FAKE_SSH_STATE:?}"
src="" dst=""
while [ $# -gt 0 ]; do case "$1" in -o) shift 2; continue ;; *) if [ -z "$src" ]; then src="$1"; else dst="$1"; fi ;; esac; shift; done
if [ "${FAKE_MOUNT_STYLE:-}" = linux ]; then
	printf '%s on %s type fuse.sshfs (rw,nosuid,nodev)\n' "$src" "$(printf '%s' "$dst" | sed 's/ /\\040/g')" >>"$state/mounts"
else
	printf '%s on %s (macfuse, nodev, nosuid, synchronous, mounted by bob)\n' "$src" "$dst" >>"$state/mounts"
fi
