#!/usr/bin/env bash
# Fake ssh for the tests. A master is a background sleep whose PID is kept in $FAKE_SSH_STATE/master;
# a command through it runs locally with sh, in $FAKE_HOME. A command with no master fails loudly,
# since the scripts must never open a connection of their own.
state="${FAKE_SSH_STATE:?}"
mkdir -p "$state"
G=0 O="" master=0 n=0 sock=""
while [ $# -gt 0 ]; do
	case "$1" in
		-o) case "$2" in ControlPath=*) sock="${2#ControlPath=}" ;; esac; shift 2; continue ;;
		-S) sock="$2"; shift 2; continue ;;
		-O) O="$2"; shift 2; continue ;;
		-G) G=1 ;;
		-n) n=1 ;;
		-MNf) master=1 ;;
		-*) ;;
		*) alias="$1"; shift; break ;;
	esac
	shift
done
echo "$alias" >>"$state/aliases"
if [ "$G" = 1 ]; then
	printf 'hostname example.org\nuser bob\nport 2222\ncontrolpath %s\n' "$(dirname "$sock")/fakehash"
	exit 0
fi
alive() { [ -f "$state/master" ] && kill -0 "$(cat "$state/master")" 2>/dev/null; }
case "$O" in
	check) [ -z "${FAKE_SSH_CHECK_HANG:-}" ] || exec sleep 1000
		if alive; then echo "Master running (pid=$(cat "$state/master"))" >&2; exit 0; fi
		echo "Control socket connect($sock): No such file or directory" >&2; exit 255 ;;
	exit) if alive; then kill "$(cat "$state/master")"; rm -f "$state/master"; fi; exit 0 ;;
esac
if [ "$master" = 1 ]; then
	case "${FAKE_SSH_MASTER:-}" in
		auth) echo "bob@example.org: Permission denied (publickey,password)." >&2; exit 255 ;;
		down) echo "ssh: connect to host example.org port 2222: Operation timed out" >&2; exit 255 ;;
		hostkey) echo "Host key verification failed." >&2; exit 255 ;;
	esac
	# shellcheck disable=SC2217 # Every descriptor closed, so that no caller's pipe stays open.
	sleep 1000 >/dev/null 2>&1 </dev/null &
	echo $! >"$state/master"
	exit 0
fi
if ! alive; then
	echo "FAKE SSH: direct login without a master" >&2
	echo direct >>"$state/direct"
	exit 255
fi
[ -z "${FAKE_SSH_HANG:-}" ] || exec sleep 1000
cd "${FAKE_HOME:?}" || exit 1
# What a remote login may print before the command's own output.
[ -z "${FAKE_SSH_BANNER:-}" ] || echo "$FAKE_SSH_BANNER"
if [ "$n" = 1 ]; then exec ${FAKE_SSH_SHELL:-sh} -c "$*" </dev/null; fi
exec ${FAKE_SSH_SHELL:-sh} -c "$*"
