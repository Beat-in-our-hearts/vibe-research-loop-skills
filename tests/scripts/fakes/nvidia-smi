#!/usr/bin/env bash
# Fake nvidia-smi for the tests: answers each query from files in $FAKE_GPU_DIR, or fails as told.
d="${FAKE_GPU_DIR:?}"
[ -z "${FAKE_SMI_HANG:-}" ] || exec sleep 1000
case "$*" in
	*mig.mode*) cat "$d/mig" 2>/dev/null ;;
	*index,name*) cat "$d/names" 2>/dev/null ;;
	*index,uuid*) cat "$d/gpus" ;;
	*compute-apps*) [ -z "${FAKE_APPS_FAIL:-}" ] || exit 9; cat "$d/apps" 2>/dev/null ;;
	*) exit 2 ;;
esac
